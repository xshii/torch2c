{
  "version": "1.0",
  "description": "torch2c NPU 编译器 — Skill 自动触发规则。适用于 Claude Code / GLM CLI / Cursor 等 AI 编码工具。",

  "skills": {
    "t2c-build": {
      "type": "workflow",
      "enforcement": "suggest",
      "priority": "high",
      "description": "智能开发引擎 — 融合 TDD / 规格测试 / 调试 / 迭代的 all-in-one 开发工作流",
      "promptTriggers": {
        "keywords": [
          "fix", "bug", "feat", "feature", "refactor", "重构",
          "perf", "optimize", "性能", "优化",
          "test", "测试", "TDD", "spec", "规格",
          "debug", "调试", "报错", "失败", "不通过",
          "改动", "修改", "迭代", "workflow",
          "Red", "Green", "用例设计", "不变量", "决策表",
          "loop", "自动", "自动迭代", "一直跑", "循环",
          "PUA", "pua", "质量", "红线", "闭环", "穷尽"
        ],
        "intentPatterns": [
          "(fix|debug|修|排查).*(bug|error|fail|报错|问题)",
          "(add|implement|加|新增|写).*(feature|function|功能)",
          "(refactor|重构|优化).*(code|pass|模块)",
          "(write|design|设计).*(test|测试|用例)",
          "(how to|怎么).*(test|debug|调试|排查)",
          "(loop|自动|迭代).*(完成|搞定|实现|修复)",
          "(PUA|质量|红线|闭环).*(模式|检查|验证)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "torch2c/**/*.py",
          "npu_cpu_mock/**/*.c",
          "npu_cpu_mock/**/*.h"
        ],
        "pathExclusions": [
          "torch2c/integration/config/**",
          "docs/**"
        ]
      },
      "modes": {
        "fix":      { "triggers": ["fix", "bug", "修", "报错", "失败"] },
        "feat":     { "triggers": ["feat", "add", "加", "新增", "功能"] },
        "refactor": { "triggers": ["refactor", "重构"] },
        "perf":     { "triggers": ["perf", "optimize", "性能", "优化"] },
        "test":     { "triggers": ["test", "测试", "TDD", "spec", "用例"] },
        "debug":    { "triggers": ["debug", "调试", "排查"] },
        "loop":     { "triggers": ["loop", "自动", "迭代", "一直跑", "循环"] }
      }
    },

    "t2c-scaffold": {
      "type": "workflow",
      "enforcement": "suggest",
      "priority": "high",
      "description": "脚手架引擎 — 新增算子 / Pass / 格式的完整 checklist + 自动生成",
      "promptTriggers": {
        "keywords": [
          "add op", "新增算子", "加算子", "add operator",
          "add pass", "新增 pass", "加 pass", "优化 pass",
          "format", "dtype", "格式", "对齐", "alignment",
          "NZ", "ZZ", "NN", "block_pad",
          "scaffold", "脚手架", "模板"
        ],
        "intentPatterns": [
          "(add|新增|加|支持).*(op|算子|operator)",
          "(add|新增|加).*(pass|优化)",
          "(add|新增|修改).*(format|dtype|格式|对齐)",
          "(how to|怎么).*(add|新增).*(op|pass|format)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "torch2c/integration/config/*.yaml",
          "npu_cpu_mock/include/npu_api.h",
          "npu_cpu_mock/src/*.c",
          "torch2c/common/pass_config.py",
          "torch2c/common/config_schemas.py",
          "torch2c/common/sizing.py",
          "torch2c/integration/_pass_descriptions.py"
        ],
        "contentPatterns": [
          "direct_mappings",
          "c_api_signatures",
          "OptionalPass",
          "_DEFAULT_ALIGNMENT",
          "block_pad.alignment",
          "_PassDesc",
          "GraphBuilder",
          "_PassSlot"
        ]
      },
      "types": {
        "op":     { "triggers": ["op", "算子", "operator", "mapping"] },
        "pass":   { "triggers": ["pass", "优化", "optimization"] },
        "format": { "triggers": ["format", "dtype", "格式", "对齐"] }
      }
    },

    "t2c-arch": {
      "type": "reference",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "架构大脑 — 编译流程 / 硬件模型 / IR 生命周期 / 配置系统 / 环境搭建参考",
      "promptTriggers": {
        "keywords": [
          "架构", "architecture", "pipeline", "流水线", "编译流程",
          "hardware", "硬件", "Cube", "Vector", "IDMA", "DMA",
          "Graph IR", "Node", "Tensor", "format",
          "config", "配置", "YAML",
          "setup", "安装", "环境", "怎么跑",
          "tools", "VSCode", "task",
          "ComputeUnit", "TensorFormat", "Storage", "FormatAnnotation",
          "GraphBuilder", "graph_transaction", "_PassSlot",
          "analysis pass", "transform pass", "pass依赖"
        ],
        "intentPatterns": [
          "(understand|explain|理解|解释).*(arch|架构|pipeline|流水线)",
          "(how|怎么).*(compile|编译|work|运行|工作)",
          "(setup|install|配置|安装).*(env|environment|环境|开发)",
          "(what is|什么是).*(format|Graph|Node|Tensor|pass)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "docs/**/*.md",
          "CLAUDE.md",
          "SKILLS.md",
          ".vscode/**"
        ]
      }
    }
  },

  "guardrails": {
    "config-consistency": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "description": "配置一致性 — 修改任何 YAML 配置后必须跑一致性测试",
      "fileTriggers": {
        "pathPatterns": [
          "torch2c/integration/config/*.yaml"
        ]
      },
      "blockMessage": "YAML 配置已修改。必须运行: .venv/bin/pytest torch2c/integration/tests/test_config_consistency.py -v",
      "autoFix": ".venv/bin/pytest torch2c/integration/tests/test_config_consistency.py -v"
    },
    "alignment-hardcode": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "critical",
      "description": "禁止硬编码对齐值",
      "fileTriggers": {
        "pathPatterns": ["torch2c/**/*.py"],
        "contentPatterns": ["calc_padded_size\\(.*\\(16,\\s*16\\)"]
      },
      "blockMessage": "禁止硬编码对齐值 (16,16)。使用 get_dim_align(t.format, t.dtype)"
    },
    "c-mock-addr": {
      "type": "guardrail",
      "enforcement": "warn",
      "priority": "critical",
      "description": "C mock 中禁止使用 .addr",
      "fileTriggers": {
        "pathPatterns": ["npu_cpu_mock/**/*.c"],
        "contentPatterns": ["\\.addr\\b"]
      },
      "blockMessage": "禁止使用 .addr。使用 npu_t_ptr(tensor) 或 tensor.ptr"
    }
  },

  "installation": {
    "claude_code": {
      "method": "commands",
      "path": ".claude/commands/t2c-*.md",
      "usage": "/t2c-build, /t2c-scaffold, /t2c-arch"
    },
    "glm_cli": {
      "method": "skills_index",
      "index": "SKILLS.md",
      "rules": ".claude/skill-rules.json",
      "usage": "GLM CLI 读取 SKILLS.md 定位 skill 文件，skill-rules.json 控制自动触发"
    },
    "cursor": {
      "method": "cursorrules",
      "path": ".cursorrules",
      "note": "将 SKILLS.md 内容精简后写入 .cursorrules"
    },
    "generic": {
      "method": "system_prompt",
      "note": "将 CLAUDE.md + SKILLS.md 作为 system prompt 注入"
    }
  }
}
